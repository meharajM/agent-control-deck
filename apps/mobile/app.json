{
  "expo": {
    "name": "Agent Deck",
    "slug": "agent-deck",
    "version": "1.0.0",
    "scheme": "agentdeck",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agentdeck.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Agent Deck discovers your computer on the local network.",
        "NSBonjourServices": ["_agent-deck._tcp"]
      }
    },
    "android": {
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE", "ACCESS_WIFI_STATE", "CHANGE_WIFI_MULTICAST_STATE"],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.agentdeck.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Agent Deck to use Face ID for high-risk approval confirmation."
        }
      ]
    ]
  }
}
