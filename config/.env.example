# Core bridge
AGENT_DECK_DATA_DIR=
AGENT_DECK_LOG_LEVEL=info
AGENT_DECK_LISTEN_HOST=127.0.0.1
AGENT_DECK_LISTEN_PORT=7443
AGENT_DECK_ENABLE_MDNS=false

# Optional private/direct endpoints
AGENT_DECK_PUBLIC_NAME=

# Optional relay; leave empty for server-free operation
AGENT_DECK_RELAY_URL=
AGENT_DECK_RELAY_GRANT=

# Managed OpenCode process
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Claude credentials remain host-side and use supported provider configuration
ANTHROPIC_API_KEY=
