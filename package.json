{
  "name": "agent-deck",
  "version": "0.1.0-preview.3",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "start:bridge": "pnpm --filter @agent-deck/bridge start",
    "start:bridge:fake": "BRIDGE_RUNTIME=fake pnpm start:bridge",
    "start:bridge:codex": "BRIDGE_RUNTIME=codex pnpm start:bridge",
    "start:bridge:opencode": "BRIDGE_RUNTIME=opencode pnpm start:bridge",
    "start:agent-deck": "pnpm build && pnpm start:bridge",
    "dev": "pnpm build && pnpm --filter @agent-deck/bridge start"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
